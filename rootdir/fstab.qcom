# Android fstab file. Using J7
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#TODO: Add 'check' as fs_mgr_flags with data partition.
# Currently we dont have e2fsck compiled. So fs check would failed.

#<src>                                       <mnt_point>  <type>  <mnt_flags and options>                     <fs_mgr_flags>
/dev/block/mmcblk0p24         /system      ext4    ro,errors=panic,noload                       wait,verify
/dev/block/mmcblk0p27       /data        ext4    nosuid,nodev,noatime,noauto_da_alloc,discard,journal_async_commit,errors=panic      wait,check,encryptable=footer


# VOLD
/devices/soc.0/7864900.sdhci/mmc_host/mmc*   auto        vfat    default     voldmanaged=sdcard1:auto,noemulatedsd
/devices/platform/msm_hsusb_host/usb*         auto        vfat    default     voldmanaged=usbdisk:auto
