+CONFIG_NET_EMATCH=y   #basic uses extended matches so this has to be present
+CONFIG_NET_SCH_INGRESS=y # classifier for ingress packet
+#EPDG
+
+# MMAP READ-AROUND
+CONFIG_MMAP_READAROUND_LIMIT=16
