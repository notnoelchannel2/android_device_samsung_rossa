+#CONFIG_KSM=y
+#CONFIG_ADAPTIVE_KSM=y
+
+#EPDG
+CONFIG_NET_CORE=y
+CONFIG_NET_SCH_PRIO=y
+CONFIG_NET_SCHED=y   #depends on CONFIG_NET  which is enabled by default.. coz not seeing in the config file
