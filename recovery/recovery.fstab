
#<src>									<mnt_point>		<type>	<mnt_flags and options>	<fs_mgr_flags>
/dev/block/mmcblk0p16		/boot			emmc	default		                                                recoveryonly
/dev/block/mmcblk0p17	/recovery		emmc	default		                                                recoveryonly
/dev/block/mmcblk0p24	/system			ext4	ro,barrier=1									            wait
/dev/block/mmcblk0p27	/data			ext4	rw,seclabel,nosuid,nodev,noatime,discard,data=ordered		wait,check
/dev/block/mmcblk0p25		/cache			ext4	rw,noatime,nosuid,nodev,barrier=1,data=ordered	            wait,check
/dev/block/bootdevice/by-name/apnhlos	/firmware		vfat	ro,		                                                    wait,check
/dev/block/bootdevice/by-name/modem		/modem			vfat	ro,		                                                    wait,check

/dev/block/mmcblk1p1					/external_sd	auto	rw,                                                         wait,voldmanaged=external_sd:auto
/devices/soc.0/7824900.sdhci/mmc_host   /storage/sdcard   auto    rw,                                                       wait,voldmanaged=sdcard:auto
