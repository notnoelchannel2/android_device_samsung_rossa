+# Wifi features (Qualcomm)
+#
+CONFIG_NET_CORE=y
+CONFIG_WIRELESS=y
+CONFIG_WIRELESS_EXT_SYSFS=y
+CONFIG_WEXT_CORE=y
+CONFIG_WEXT_PROC=y
+CONFIG_CFG80211=y
+CONFIG_CFG80211_DEFAULT_PS=y
+CONFIG_WLAN_REGION_CODE=300
+CONFIG_TARGET_LOCALE_CHN=y
+CONFIG_CFG80211_ALLOW_RECONNECT is not set
+CONFIG_WLAN=y
+CONFIG_WIRELESS_EXT=y
+CONFIG_WEXT_PRIV=y
+CONFIG_MODULES=y
+CONFIG_MODULE_UNLOAD=y
+CONFIG_MODULE_FORCE_UNLOAD=y
+CONFIG_WCNSS_REGISTER_DUMP_ON_BITE=y
+
+# MUIC
+CONFIG_SM5504_MUIC=y
+# CONFIG_MUIC_SM5502_SUPPORT_LANHUB_TA is not set
+CONFIG_MUIC_SUPPORT_RUSTPROOF=y
+CONFIG_USBID_STANDARD_VER_01=y
+
+#Touch Screen
+CONFIG_TOUCHSCREEN_IST30XX_CORE3=y
+CONFIG_TOUCHSCREEN_TA_CALLBACK_ENABLE=y
+
+# VIBRATOR
+CONFIG_MSM_VIBRATOR=y
+
+#AUDIO
+CONFIG_RADIO_IRIS=y
+CONFIG_RADIO_IRIS_TRANSPORT=m
+
+#LCD
+CONFIG_PANEL_SC7798A_BV045WVM_WVGA=y
+CONFIG_PANEL_HX8369B_BV045WVM_WVGA=y
+
+CONFIG_MFD_RT5033=y
+CONFIG_MFD_RT5033_RESET_WA=y
+CONFIG_MFD_RT5033_SLDO_VBUSDET=n
+CONFIG_BATTERY_SAMSUNG=y
+CONFIG_BATTERY_SAMSUNG_DATA_FILE="rossa_battery_data.h"
+CONFIG_SAMSUNG_LPM_MODE=y
+CONFIG_CHARGER_RT5033=y
+CONFIG_FUELGAUGE_RT5033=y
+CONFIG_REGULATOR_RT5033=y
+#CONFIG_BATTERY_SWELLING is not set
+
+# Pre-power on alarm
+# CONFIG_RTC_AUTO_PWRON is not set
+# CONFIG_RTC_AUTO_PWRON_PARAM is not set
+
+#CAMERA
+CONFIG_SR200PC20=y
+CONFIG_MSM_EEPROM=n
+CONFIG_MSM_OTP=y
+CONFIG_SR544=y
+
+#FLASH
+CONFIG_FLASHLIGHT=y
+CONFIG_RT_FLASH_LED=y
+CONFIG_FLED_RT5033=y
+CONFIG_FLED_RT5033_EXT_GPIO=y
+
+#optimize mmc block delay on resume
+CONFIG_MMC_BLOCK_DEFERRED_RESUME=y
+
+# RTCC v3
+CONFIG_SWAP=y
+CONFIG_ZSMALLOC=y
+CONFIG_ZRAM=y
+CONFIG_RUNTIME_COMPCACHE=y
+CONFIG_KSWAPD_NOSWAP=y
+
+
+#NFC
+CONFIG_SEC_NFC=y
+CONFIG_SEC_NFC_I2C=y
+CONFIG_SEC_NFC_USE_8916_BBCLK2=y
+CONFIG_SEC_NFC_IF_I2C=y
+CONFIG_SEC_NFC_PRODUCT_N5=y
+
+#CONFIGURE Knox UID PID
+#CONFIG_KNOX_VPN_UID_PID is not set
